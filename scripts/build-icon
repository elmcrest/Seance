#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
output=$1
work=$(mktemp -d "$PWD/.build/icon.XXXXXX")
trap 'rm -rf "$work"' EXIT
iconset="$work/Seance.iconset"
mkdir "$iconset"
sips -s format png candle.svg --out "$work/master.png" >/dev/null
for size in 16 32 128 256 512; do
    sips -z "$size" "$size" "$work/master.png" --out "$iconset/icon_${size}x${size}.png" >/dev/null
    retina=$((size * 2))
    sips -z "$retina" "$retina" "$work/master.png" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$output"
