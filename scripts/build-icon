#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
output=$1
work=$(mktemp -d "$PWD/.build/icon.XXXXXX")
trap 'rm -rf "$work"' EXIT
iconset="$work/Seance.iconset"
mkdir "$iconset"
if ! command -v resvg >/dev/null; then
    echo "Install resvg to render the CRT icon (brew install resvg)." >&2
    exit 1
fi
resvg retro-crt-display.svg "$work/full.png"
xsltproc --nonet scripts/small-icon.xsl retro-crt-display.svg > "$work/small.svg"
resvg "$work/small.svg" "$work/small.png"
for size in 16 32 128 256 512; do
    master="$work/full.png"
    if [ "$size" -le 32 ]; then master="$work/small.png"; fi
    sips -z "$size" "$size" "$master" --out "$iconset/icon_${size}x${size}.png" >/dev/null
    retina=$((size * 2))
    sips -z "$retina" "$retina" "$master" --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$output"
