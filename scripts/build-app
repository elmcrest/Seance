#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
signing_identity=$(git config --local --get seance.signingIdentity || true)
signing_identity=${signing_identity:--}
configuration=${1:-debug}
case "$configuration" in
    debug) app_dir="$PWD/.build/Seance.app" ;;
    release) app_dir="$PWD/.build/distribution/Seance.app" ;;
    *) echo "Usage: scripts/build-app [debug|release]" >&2; exit 2 ;;
esac
./scripts/prepare-ghostty
swift build -c "$configuration" --manifest-cache none --product Seance
swift build -c "$configuration" --manifest-cache none --product SeanceCLI
bin_dir=$(swift build -c "$configuration" --manifest-cache none --show-bin-path)
mkdir -p "$app_dir/Contents/MacOS"
cp "$bin_dir/Seance" "$app_dir/Contents/MacOS/Seance"
mkdir -p "$app_dir/Contents/Helpers"
cp "$bin_dir/SeanceCLI" "$app_dir/Contents/Helpers/seance"
codesign --force --sign "$signing_identity" "$app_dir/Contents/Helpers/seance"
cp Sources/Info.plist "$app_dir/Contents/Info.plist"
source_dir="$PWD/.build/vendor/ghostty"
resources="$app_dir/Contents/Resources"
mkdir -p "$resources"
./scripts/build-icon "$resources/Seance.icns"
ditto "$source_dir/zig-out/share/ghostty" "$resources/ghostty"
ditto "$source_dir/zig-out/share/terminfo" "$resources/terminfo"
cp "$source_dir/LICENSE" "$resources/Ghostty-LICENSE"
codesign --force --sign "$signing_identity" "$app_dir"
